# DALLAH DIGITAL VMS - Environment Variables
# Copy this file to .env and fill in the values
# For EAS builds, configure these in eas.json or via eas secret:create

# Backend API Configuration
EXPO_PUBLIC_API_BASE_URL=https://your-backend-url.com
# Microsoft OAuth endpoint (can be same as API URL or separate auth server)
EXPO_PUBLIC_MICROSOFT_AUTH_URL=https://your-backend-url.com

# Firebase Configuration
# Get these values from Firebase Console > Project Settings > General
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase App IDs (platform-specific)
# Get these from Firebase Console > Project Settings > Your apps
EXPO_PUBLIC_FIREBASE_APP_ID_WEB=1:xxxx:web:xxxx
EXPO_PUBLIC_FIREBASE_APP_ID_ANDROID=1:xxxx:android:xxxx
EXPO_PUBLIC_FIREBASE_APP_ID_IOS=1:xxxx:ios:xxxx

# Firebase Cloud Messaging VAPID Key (for web push notifications)
# Get this from Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
EXPO_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key

# Note: All variables prefixed with EXPO_PUBLIC_ are bundled into the app
# and accessible via process.env.EXPO_PUBLIC_*
