# DALLAH DIGITAL VMS - Environment Variables
# Copy this file to .env and fill in the values
# For EAS builds, configure these in eas.json or via eas secret:create

# Backend / web configuration
# QA and production defaults are committed in config/app-environments.js;
# these variables only OVERRIDE them for QA builds (Replit shared env, CI).
# `npm run build:web:production` and `APP_VARIANT=production` EAS builds
# ignore/refuse QA hosts, so production never depends on this file.
EXPO_PUBLIC_API_BASE_URL=https://vms-backend-app-qa.replit.app
# Microsoft OAuth base URL (defaults to the API base URL)
EXPO_PUBLIC_MICROSOFT_AUTH_URL=https://vms-backend-app-qa.replit.app
# Public web domain: iOS Universal Links, Android App Links, Outlook add-in.
# Must serve /.well-known/apple-app-site-association and /.well-known/assetlinks.json.
EXPO_PUBLIC_APP_DOMAIN=vms-frontend-folio3.replit.app
# Where privacy-policy.html / terms-conditions.html are served from
EXPO_PUBLIC_LEGAL_PAGES_URL=https://vms-frontend-folio3.replit.app

# Per-variant override files (.env.staging / .env.production, git-ignored) use
# the same keys WITHOUT the EXPO_PUBLIC_ prefix:
#   API_BASE_URL=..., MICROSOFT_AUTH_URL=..., APP_DOMAIN=..., LEGAL_PAGES_URL=...
# Never put EXPO_PUBLIC_* keys in .env.production: the Expo CLI loads that file
# for every `expo export`, including QA builds.

# Firebase Configuration
# Get these values from Firebase Console > Project Settings > General
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase App IDs (platform-specific)
# Get these from Firebase Console > Project Settings > Your apps
EXPO_PUBLIC_FIREBASE_APP_ID_WEB=1:xxxx:web:xxxx
EXPO_PUBLIC_FIREBASE_APP_ID_ANDROID=1:xxxx:android:xxxx
EXPO_PUBLIC_FIREBASE_APP_ID_IOS=1:xxxx:ios:xxxx

# Firebase Cloud Messaging VAPID Key (for web push notifications)
# Get this from Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
EXPO_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key

# Note: All variables prefixed with EXPO_PUBLIC_ are bundled into the app
# and accessible via process.env.EXPO_PUBLIC_*
