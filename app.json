{
  "expo": {
    "name": "Dallah Albaraka VMS",
    "slug": "dallah-vms",
    "version": "1.0.35",
    "orientation": "portrait",
    "icon": "./assets/images/header-icon-dark.png",
    "scheme": "dallahvms",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/header-icon-dark.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dallah.vms",
      "googleServicesFile": "./config/qa/google-services.json",
      "supportsRTL": true,
      "permissions": ["android.permission.POST_NOTIFICATIONS"]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dallah.vms",
      "appleTeamId": "SNJM77V43A",
      "buildNumber": "66",
      "googleServicesFile": "./config/qa/GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"],
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to update your profile picture."
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/header-icon-dark.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/header-icon-dark.png",
          "color": "#F58423"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/crashlytics",
      "./plugins/withNotificationManifestFix",
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to your photo library to update your profile picture."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://vms-backend-folio3.replit.app",
      "microsoftAuthUrl": "https://vms-backend-folio3.replit.app",
      "eas": {
        "projectId": "33b6baff-6c89-44be-905f-006d0da4434d"
      }
    },
    "owner": "ahsanshafiq"
  }
}
