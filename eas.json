{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "prebuildCommand": "bash scripts/fix-firebase-headers.sh"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": false,
        "prebuildCommand": "bash scripts/fix-firebase-headers.sh"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false,
        "prebuildCommand": "bash scripts/fix-firebase-headers.sh"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "prebuildCommand": "bash scripts/fix-firebase-headers.sh"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "preview": {},
    "production": {}
  }
}
