{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": false,
        "googleServicesFile": "./config/qa/GoogleService-Info.plist"
      },
      "android": {
        "buildType": "apk",
        "googleServicesFile": "./config/qa/google-services.json"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false,
        "googleServicesFile": "./config/prod/GoogleService-Info.plist"
      },
      "android": {
        "buildType": "app-bundle",
        "googleServicesFile": "./config/prod/google-services.json"
      }
    },
    "production-preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "googleServicesFile": "./config/prod/GoogleService-Info.plist"
      },
      "android": {
        "buildType": "apk",
        "googleServicesFile": "./config/prod/google-services.json"
      }
    }
  },
  "submit": {
    "preview": {},
    "production": {}
  }
}
