{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "env": { "APP_VARIANT": "staging" },
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development-device": {
      "env": { "APP_VARIANT": "staging" },
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "env": { "APP_VARIANT": "staging" },
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": { "APP_VARIANT": "production" },
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-preview": {
      "env": { "APP_VARIANT": "production" },
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {},
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "preview": {},
    "production": {}
  }
}
