{
  "name": "dallah-vms",
  "main": "index.js",
  "version": "3.0.0",
  "scripts": {
    "dev": "npm run dev:mobile",
    "dev:mobile": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN npx expo start --port 5000 --host tunnel",
    "dev:web": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN npx expo start --web --port 5000 --host tunnel",
    "dev:all": "npx expo start --host tunnel",
    "start": "npx expo start",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "build:web": "node scripts/build-web.js --variant qa",
    "build:web:production": "node scripts/build-web.js --variant production",
    "build:ios": "node scripts/build-ios-with-apple-key.js",
    "build:android": "npx eas build --platform android --profile production",
    "build:preview:ios": "node scripts/build-ios-with-apple-key.js --eas-profile preview",
    "build:preview:android": "npx eas build --platform android --profile preview",
    "publish:all": "npm run build:web && npm run build:ios && npm run build:android",
    "check:canonical-modules": "node scripts/check-canonical-modules.js",
    "eas-build-pre-install": "node scripts/check-canonical-modules.js",
    "test:ios-auth": "node --test scripts/apple-auth-service-key.test.js",
    "check:ios-auth-live": "node scripts/check-apple-auth-service-key-live.js",
    "lint": "npx expo lint",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\""
  },
  "dependencies": {
    "@expo-google-fonts/albert-sans": "^0.4.2",
    "@expo-google-fonts/cairo": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-firebase/app": "^23.8.4",
    "@react-native-firebase/crashlytics": "^23.8.4",
    "@react-native-firebase/messaging": "^23.8.4",
    "@react-navigation/bottom-tabs": "^7.9.1",
    "@react-navigation/elements": "^2.9.4",
    "@react-navigation/native": "^7.1.27",
    "@react-navigation/native-stack": "^7.9.1",
    "@tanstack/react-query": "^5.90.16",
    "@types/jest": "^30.0.0",
    "axios": "^1.13.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "dotenv": "^17.2.4",
    "expo": "~54.0.25",
    "expo-application": "^7.0.8",
    "expo-asset": "~12.0.12",
    "expo-auth-session": "~7.0.10",
    "expo-blur": "^15.0.8",
    "expo-build-properties": "^1.0.10",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-device": "^8.0.10",
    "expo-font": "~14.0.10",
    "expo-glass-effect": "~0.1.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "express": "^5.2.1",
    "firebase": "^12.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "^1.18.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.12.5",
    "react-native-worklets": "^0.5.1",
    "serve": "^14.2.5"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-auth-session",
        "expo-dev-client",
        "expo-font",
        "expo-glass-effect",
        "expo-image-picker",
        "expo-linking",
        "expo-notifications",
        "expo-updates",
        "expo-web-browser",
        "react-native-webview"
      ]
    }
  }
}
